# Copy this file to .env (same folder) and fill in only what you use. Never share your .env.

# --- Find My (On the way home + welcome home) ---
APPLE_ID=you@example.com
# only track in this window…
FINDMY_FROM=16:00
FINDMY_UNTIL=21:00
# …on these days (Mon=0 … Sun=6)
FINDMY_DAYS=0,1,2,3,4
# optional; it also learns home from where the phone sleeps
HOME_LAT=0
HOME_LNG=0
# so it can wake the TV when you arrive
TV_IP=192.168.1.50
TV_MAC=00:00:00:00:00:00

# --- Gmail (deliveries & bills) ---
GMAIL_USER=you@gmail.com
UTC_OFFSET_HOURS=4

# --- Telegram alerts (optional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
